{
  "openapi": "3.0.3",
  "info": {
    "title": "API AdaRemise",
    "description": "Documentation des routes de l'API (dépôts, objets, personnes, bénévoles, catégories, statistiques).\n",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Serveur local"
    }
  ],
  "tags": [
    {
      "name": "Dépôts"
    },
    {
      "name": "Objets"
    },
    {
      "name": "Personnes"
    },
    {
      "name": "Bénévoles"
    },
    {
      "name": "Catégories"
    },
    {
      "name": "Statistiques"
    }
  ],
  "paths": {
    "/api/depots/{id}": {
      "get": {
        "tags": [
          "Dépôts"
        ],
        "summary": "Récupérer un dépôt par son id (avec ses objets)",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Détail du dépôt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DepotDetail"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/depots": {
      "post": {
        "tags": [
          "Dépôts"
        ],
        "summary": "Créer un dépôt",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "date_depot",
                  "type",
                  "personne_id"
                ],
                "properties": {
                  "date_depot": {
                    "type": "string",
                    "format": "date"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "boutique",
                      "domicile"
                    ]
                  },
                  "personne_id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dépôt créé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Depot"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/depots/{id}/objets": {
      "post": {
        "tags": [
          "Dépôts"
        ],
        "summary": "Ajouter un objet à un dépôt existant",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPath"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "libelle",
                  "poids_kg",
                  "etat_arrivee",
                  "categorie_id"
                ],
                "properties": {
                  "libelle": {
                    "type": "string"
                  },
                  "poids_kg": {
                    "type": "number",
                    "minimum": 0.01
                  },
                  "etat_arrivee": {
                    "type": "string",
                    "enum": [
                      "bon_etat",
                      "a_reparer",
                      "hors_service"
                    ]
                  },
                  "categorie_id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Objet créé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Objet"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/objets": {
      "get": {
        "tags": [
          "Objets"
        ],
        "summary": "Lister les objets (filtrable par statut et/ou catégorie)",
        "parameters": [
          {
            "name": "statut",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "arrive",
                "en_reparation",
                "en_rayon",
                "vendu",
                "recycle"
              ]
            }
          },
          {
            "name": "categorie_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste des objets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Objet"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Objets"
        ],
        "summary": "Créer un objet (dépôt existant requis)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "libelle",
                  "poids_kg",
                  "etat_arrivee",
                  "categorie_id",
                  "depot_id"
                ],
                "properties": {
                  "libelle": {
                    "type": "string"
                  },
                  "poids_kg": {
                    "type": "number",
                    "minimum": 0.01
                  },
                  "etat_arrivee": {
                    "type": "string",
                    "enum": [
                      "bon_etat",
                      "a_reparer",
                      "hors_service"
                    ]
                  },
                  "categorie_id": {
                    "type": "integer"
                  },
                  "depot_id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Objet créé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Objet"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/objets/{id}": {
      "get": {
        "tags": [
          "Objets"
        ],
        "summary": "Récupérer le détail d'un objet",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Détail de l'objet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjetDetail"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "Objets"
        ],
        "summary": "Supprimer un objet (utilisé pour nettoyer les objets de test)",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Objet supprimé",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "objet supprimé"
                    },
                    "objet": {
                      "$ref": "#/components/schemas/Objet"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/objets/{id}/statut": {
      "patch": {
        "tags": [
          "Objets"
        ],
        "summary": "Mettre à jour le statut d'un objet",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPath"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "statut"
                ],
                "properties": {
                  "statut": {
                    "type": "string",
                    "enum": [
                      "arrive",
                      "en_reparation",
                      "en_rayon",
                      "vendu",
                      "recycle"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Objet mis à jour",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Objet"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/personnes/{id}/objets": {
      "get": {
        "tags": [
          "Personnes"
        ],
        "summary": "Historique des objets déposés par une personne",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Liste des objets déposés par cette personne",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ObjetHistorique"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/personnes": {
      "get": {
        "tags": [
          "Personnes"
        ],
        "summary": "Lister les personnes",
        "responses": {
          "200": {
            "description": "Liste des personnes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Personne"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Personnes"
        ],
        "summary": "Créer une personne",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nom",
                  "prenom"
                ],
                "properties": {
                  "nom": {
                    "type": "string"
                  },
                  "prenom": {
                    "type": "string"
                  },
                  "telephone": {
                    "type": "string",
                    "nullable": true
                  },
                  "adherente": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Personne créée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Personne"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/benevoles": {
      "get": {
        "tags": [
          "Bénévoles"
        ],
        "summary": "Lister les bénévoles",
        "responses": {
          "200": {
            "description": "Liste des bénévoles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Benevole"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/benevoles/{id}": {
      "get": {
        "tags": [
          "Bénévoles"
        ],
        "summary": "Récupérer un bénévole par son id",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Détail du bénévole",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Benevole"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/categories": {
      "get": {
        "tags": [
          "Catégories"
        ],
        "summary": "Lister les catégories",
        "responses": {
          "200": {
            "description": "Liste des catégories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Categorie"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "tags": [
          "Statistiques"
        ],
        "summary": "Statistiques du tableau de bord",
        "responses": {
          "200": {
            "description": "Statistiques globales",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "IdPath": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Requête invalide",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Ressource introuvable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ServerError": {
        "description": "Erreur serveur",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Personne": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "nom": {
            "type": "string"
          },
          "prenom": {
            "type": "string"
          },
          "telephone": {
            "type": "string",
            "nullable": true
          },
          "adherente": {
            "type": "boolean"
          }
        }
      },
      "Benevole": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "nom": {
            "type": "string"
          },
          "prenom": {
            "type": "string"
          },
          "telephone": {
            "type": "string",
            "nullable": true
          },
          "date_arrivee": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Categorie": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "libelle": {
            "type": "string"
          }
        }
      },
      "Objet": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "libelle": {
            "type": "string"
          },
          "poids_kg": {
            "type": "number"
          },
          "etat_arrivee": {
            "type": "string",
            "enum": [
              "bon_etat",
              "a_reparer",
              "hors_service"
            ]
          },
          "statut": {
            "type": "string",
            "enum": [
              "arrive",
              "en_reparation",
              "en_rayon",
              "vendu",
              "recycle"
            ]
          },
          "categorie_id": {
            "type": "integer"
          },
          "depot_id": {
            "type": "integer"
          }
        }
      },
      "ObjetDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Objet"
          },
          {
            "type": "object",
            "properties": {
              "categorie": {
                "type": "string"
              },
              "date_depot": {
                "type": "string",
                "format": "date"
              },
              "type_depot": {
                "type": "string",
                "enum": [
                  "boutique",
                  "domicile"
                ]
              },
              "donatrice_nom": {
                "type": "string"
              },
              "donatrice_prenom": {
                "type": "string"
              }
            }
          }
        ]
      },
      "ObjetHistorique": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "libelle": {
            "type": "string"
          },
          "poids_kg": {
            "type": "number"
          },
          "etat_arrivee": {
            "type": "string",
            "enum": [
              "bon_etat",
              "a_reparer",
              "hors_service"
            ]
          },
          "statut": {
            "type": "string",
            "enum": [
              "arrive",
              "en_reparation",
              "en_rayon",
              "vendu",
              "recycle"
            ]
          },
          "categorie_libelle": {
            "type": "string"
          },
          "depot_id": {
            "type": "integer"
          },
          "date_depot": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Depot": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "date_depot": {
            "type": "string",
            "format": "date"
          },
          "type": {
            "type": "string",
            "enum": [
              "boutique",
              "domicile"
            ]
          },
          "personne_id": {
            "type": "integer"
          }
        }
      },
      "DepotDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Depot"
          },
          {
            "type": "object",
            "properties": {
              "donatrice_nom": {
                "type": "string"
              },
              "donatrice_prenom": {
                "type": "string"
              },
              "objets": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Objet"
                }
              }
            }
          }
        ]
      },
      "Stats": {
        "type": "object",
        "properties": {
          "objet_par_statut": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "statut": {
                  "type": "string"
                },
                "total": {
                  "type": "integer"
                }
              }
            }
          },
          "poids_total_recu": {
            "type": "number",
            "nullable": true
          },
          "objets_en_rayon": {
            "type": "integer"
          }
        }
      }
    }
  }
}