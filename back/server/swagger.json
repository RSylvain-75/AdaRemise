{
  "openapi": "3.0.0",
  "info": {
    "title": "API La Remise",
    "version": "1.0.0",
    "description": "API de gestion de la ressourcerie La Remise"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api"
    }
  ],
  "paths": {
    "/objets": {
      "get": {
        "summary": "Liste tous les objets",
        "parameters": [
          {
            "name": "statut",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filtre les objets par statut"
          },
          {
            "name": "categorie_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Filtre les objets par catégorie"
          }
        ],
        "responses": {
          "200": {
            "description": "La liste des objets"
          }
        }
      }
    },

    "/objets/{id}": {
      "get": {
        "summary": "Récupère un objet par son identifiant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Identifiant de l'objet"
          }
        ],
        "responses": {
          "200": {
            "description": "L'objet demandé"
          },
          "404": {
            "description": "Objet introuvable"
          },
          "500": {
            "description": "Erreur serveur"
          }
        }
      }
    }
  }
}